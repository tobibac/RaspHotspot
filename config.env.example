# =============================================================================
# RaspHotspot – Konfiguration
# =============================================================================
# Diese Datei wird von install.sh nach /etc/rasphotspot/rasphotspot.conf kopiert
# und dort von allen Skripten und systemd-Units gelesen.
#
# Syntax: KEY="wert"  (keine Befehlssubstitution, keine Variablen-Verweise!)
# Die Datei wird sowohl von bash gesourct als auch von systemd als
# EnvironmentFile gelesen – deshalb nur einfache Zuweisungen verwenden.
# =============================================================================

# -----------------------------------------------------------------------------
# WLAN-Hotspot (offen, ohne Passwort)
# -----------------------------------------------------------------------------
# Name des WLANs, das der Pi aufspannt.
AP_SSID="ArizonaArizona"

# Funkland – wichtig für erlaubte Kanäle/Sendeleistung (DE, AT, CH, US ...).
AP_COUNTRY="DE"

# Frequenzband: "a" = 5 GHz (empfohlen: mehr Bandbreite, weniger Störungen),
# "bg" = 2.4 GHz (größere Reichweite, mehr Kompatibilität).
# Kann 5 GHz nicht als AP genutzt werden, schaltet die Installation automatisch
# auf 2.4 GHz um.
AP_BAND="a"

# Kanal passend zum Band (5 GHz: 36/40/44/48, 2.4 GHz: 1/6/11).
AP_CHANNEL="36"

# Fallback, falls 5 GHz nicht möglich ist.
AP_FALLBACK_BAND="bg"
AP_FALLBACK_CHANNEL="6"

# IP-Adresse des Pi im Hotspot-Netz (Clients bekommen .10 bis .200 per DHCP).
AP_IP="10.42.0.1"
AP_PREFIX="24"
AP_DHCP_START="10.42.0.10"
AP_DHCP_END="10.42.0.200"

# WLAN-Interface. Leer = automatisch erkennen (z. B. wlan0).
WIFI_IFACE=""

# Der Hotspot hat keinen Internetzugang. "no" = Clients bekommen bewusst kein
# Default-Gateway und keinen DNS-Server per DHCP. Handys behalten dadurch ihre
# mobile Datenverbindung, während sie im SonoBus-WLAN sind. "yes" = Pi wird als
# Gateway/DNS angeboten (nur nötig, wenn Clients das zwingend erwarten).
AP_OFFER_GATEWAY="no"

# Name des NetworkManager-Profils (nur relevant auf Systemen mit NetworkManager).
AP_CON_NAME="rasphotspot"

# -----------------------------------------------------------------------------
# SonoBus / AOO
# -----------------------------------------------------------------------------
# Gruppenname, in den der Pi das Audio sendet.
SB_GROUP="ArizonaArizona"

# Optionales Gruppen-Passwort (leer = offene Gruppe).
SB_GROUP_PASSWORD=""

# Anzeigename des Pi in der SonoBus-Gruppe.
SB_USERNAME="MixPre-10T"

# Port des mitgelieferten Verbindungsservers (aooserver), TCP+UDP.
SB_SERVER_PORT="10998"

# Verzeichnis für die aooserver-Logdateien (leer = nur Journal).
SB_SERVER_LOGDIR="/var/log/rasphotspot"

# -----------------------------------------------------------------------------
# Audio (Sound Devices MixPre-10T über USB)
# -----------------------------------------------------------------------------
# Suchmuster für die Soundkarte in /proc/asound/cards (Groß-/Kleinschreibung egal).
# Wird nichts gefunden, nimmt das Setup automatisch die erste USB-Karte mit Eingang.
AUDIO_CARD_MATCH="MixPre"

# Samplerate und Puffergröße. 48000/256 ist ein guter Kompromiss aus Latenz und
# Stabilität über WLAN. Kleinere Puffer = weniger Latenz, mehr Aussetzerrisiko.
SB_SAMPLE_RATE="48000"
SB_BUFFER_SIZE="256"

# Welche Kanäle des MixPre gesendet werden.
# Der MixPre-10T liefert per USB die Stereo-Mischung auf Kanal 1+2 und die
# ISO-Spuren ab Kanal 3. Standard: nur die Stereo-Mischung senden.
SB_INPUT_FIRST_CHANNEL="1"
SB_INPUT_CHANNELS="2"

# Rückweg: SonoBus gibt das Summensignal der anderen Teilnehmer auf den
# USB-Rückkanälen des MixPre aus ("yes"), oder gar nicht ("no").
SB_ENABLE_OUTPUT="yes"
SB_OUTPUT_CHANNELS="2"

# ALSA-Zugriffsart: "hw" = direkt (beste Latenz, exakte Kanalzuordnung),
# "plug" = mit automatischer Format-/Ratenumwandlung (robuster bei zickigen
# Geräten, dann sind aber immer nur die ersten Kanäle erreichbar).
AUDIO_PCM_TYPE="hw"

# Die erkannte Karte zusätzlich als ALSA-Standardgerät setzen.
AUDIO_SET_DEFAULT="yes"

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
# Benutzer, unter dem aooserver und SonoBus laufen (wird angelegt).
SERVICE_USER="sonobus"

# SonoBus headless startet normalerweise ohne X-Server. Falls im Journal
# X11-Fehler auftauchen, hier "yes" setzen – dann wird ein virtueller
# Framebuffer (xvfb) davorgeschaltet.
SB_USE_XVFB="no"

# Git-Referenz (Tag/Branch/Commit) für die Quellen. Leer = Standardbranch.
SONOBUS_GIT_REF=""
AOOSERVER_GIT_REF=""
