#!/usr/bin/env python3
"""Setzt das Passwort für die Einstellungsseite.

  sudo rasphotspot-admin-password            # fragt nach dem Passwort
  sudo rasphotspot-admin-password --random   # würfelt eins und zeigt es an
"""

import getpass
import os
import secrets
import sys

sys.path.insert(0, "/usr/local/lib/rasphotspot")

SECRET_FILE = "/etc/rasphotspot/admin.secret"
WORDS = "abcdefghijkmnopqrstuvwxyz23456789"


def hash_password(password):
    import hashlib
    salt = secrets.token_hex(8)
    digest = hashlib.sha256((salt + password).encode("utf-8")).hexdigest()
    return f"sha256${salt}${digest}"


def random_password(length=12):
    return "".join(secrets.choice(WORDS) for _ in range(length))


def write_secret(password, owner_group=None):
    os.makedirs(os.path.dirname(SECRET_FILE), exist_ok=True)
    tmp = SECRET_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        handle.write(hash_password(password) + "\n")
    os.chmod(tmp, 0o640)
    if owner_group:
        import grp
        try:
            os.chown(tmp, 0, grp.getgrnam(owner_group).gr_gid)
        except (KeyError, PermissionError):
            pass
    os.replace(tmp, SECRET_FILE)


def main():
    if os.geteuid() != 0:
        print("Bitte mit sudo ausführen.", file=sys.stderr)
        return 1

    group = os.environ.get("RASPHOTSPOT_SERVICE_USER", "sonobus")

    if "--random" in sys.argv:
        password = random_password()
        write_secret(password, group)
        print(f"Neues Passwort für die Einstellungsseite: {password}")
        return 0

    password = getpass.getpass("Neues Passwort: ")
    if len(password) < 6:
        print("Mindestens 6 Zeichen, bitte.", file=sys.stderr)
        return 1
    if password != getpass.getpass("Wiederholen: "):
        print("Die Eingaben stimmen nicht überein.", file=sys.stderr)
        return 1

    write_secret(password, group)
    print("Passwort gesetzt.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
