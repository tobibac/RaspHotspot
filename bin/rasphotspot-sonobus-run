#!/bin/bash
# -----------------------------------------------------------------------------
# rasphotspot-sonobus-run
#
# Startet SonoBus headless und verbindet sich mit der konfigurierten Gruppe auf
# dem lokalen Verbindungsserver (aooserver). Wird von sonobus-sender.service
# als unprivilegierter Dienstbenutzer aufgerufen.
# -----------------------------------------------------------------------------
set -euo pipefail

LIB_DIR="/usr/local/lib/rasphotspot"
[ -f "${LIB_DIR}/common.sh" ] || LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck source=../lib/common.sh
. "${LIB_DIR}/common.sh"

load_config

# 1. Auf die Soundkarte warten (USB-Gerät kann nach dem Boot noch fehlen).
for i in $(seq 1 60); do
    if detect_audio_card "${AUDIO_CARD_MATCH:-}" >/dev/null; then break; fi
    [ "$i" -eq 1 ] && log "Warte auf das USB-Audiointerface (${AUDIO_CARD_MATCH:-USB}) ..."
    sleep 2
done
detect_audio_card "${AUDIO_CARD_MATCH:-}" >/dev/null || \
    die "Audiointerface nicht gefunden – MixPre einschalten und USB-Audio aktivieren."

# 2. Auf den Verbindungsserver warten.
if ! wait_for_port 127.0.0.1 "${SB_SERVER_PORT:-10998}" 60; then
    die "aooserver auf Port ${SB_SERVER_PORT:-10998} nicht erreichbar."
fi

# 3. SonoBus starten.
# Achtung: SonoBus (JUCE) nimmt Werte bei Langoptionen nur in der Form
# --option=wert an. Mit Leerzeichen getrennt werden sie ignoriert und der
# Headless-Start bricht mit "you need to specify a group" ab.
args=(
    --headless
    "--group=${SB_GROUP}"
    "--username=${SB_USERNAME}"
    "--connectionserver=127.0.0.1:${SB_SERVER_PORT}"
)
[ -n "${SB_GROUP_PASSWORD:-}" ] && args+=("--group-password=${SB_GROUP_PASSWORD}")

log "SonoBus: Gruppe '${SB_GROUP}' als '${SB_USERNAME}' auf 127.0.0.1:${SB_SERVER_PORT}"

# Selbst gebaut liegt sonobus in /usr/local/bin, aus einem Paket in /usr/bin.
SONOBUS_BIN="$(command -v sonobus 2>/dev/null || true)"
[ -n "$SONOBUS_BIN" ] || SONOBUS_BIN="/usr/local/bin/sonobus"

if [ "${SB_USE_XVFB:-no}" = "yes" ] && command -v xvfb-run >/dev/null 2>&1; then
    exec xvfb-run -a "$SONOBUS_BIN" "${args[@]}"
fi

exec "$SONOBUS_BIN" "${args[@]}"
