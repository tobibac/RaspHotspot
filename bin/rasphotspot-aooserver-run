#!/bin/bash
# Startet den AOO-Verbindungsserver mit den Werten aus der Konfiguration.
set -euo pipefail

LIB_DIR="/usr/local/lib/rasphotspot"
[ -f "${LIB_DIR}/common.sh" ] || LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck source=../lib/common.sh
. "${LIB_DIR}/common.sh"

load_config

args=(--port "${SB_SERVER_PORT:-10998}")

# Logverzeichnis nur benutzen, wenn es existiert und beschreibbar ist.
if [ -n "${SB_SERVER_LOGDIR:-}" ] && [ -w "${SB_SERVER_LOGDIR}" ]; then
    args+=(--logdir "${SB_SERVER_LOGDIR}")
fi

log "aooserver auf Port ${SB_SERVER_PORT:-10998} (Gruppe: ${SB_GROUP})"
exec /usr/local/bin/aooserver "${args[@]}"
