[Unit]
Description=RaspHotspot Begruessungsseite (Captive Portal)
After=network.target
Wants=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
ExecStart=/usr/local/bin/rasphotspot-portal
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3

# Port 80 als unprivilegierter Benutzer
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Nur dieses eine Verzeichnis ist beschreibbar: dort legt die Einstellungsseite
# ihren Vorschlag ab, den rasphotspot-apply anschliessend als root prueft.
ReadWritePaths=/var/lib/rasphotspot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
